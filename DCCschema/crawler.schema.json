{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crawler.schema.json",
  "title": "Crawler",
  "type": "object",
  "properties": {
    "id": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "class": {
      "type": [
        "string",
        "null"
      ]
    },
    "species": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": [
        "string",
        "null"
      ]
    },
    "first_appearance": {
      "type": "object",
      "properties": {
        "book_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "chapter": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "required": [
        "book_id",
        "chapter"
      ],
      "additionalProperties": false
    },
    "affiliations": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "class",
    "species",
    "status",
    "first_appearance",
    "affiliations",
    "summary"
  ],
  "additionalProperties": false
}
